  "license": "MIT",
  "devDependencies": {
    "webpack": "^1.12.6"
  },
  "dependencies": {
    "backbone": "^1.4.0",
    "cytoscape": "^3.11.0",
    "cytoscape-cose-bilkent": "^4.1.0",
    "cytoscape-cxtmenu": "^3.1.1",
    "cytoscape-dagre": "*",
    "cytoscape-dblclick": "^0.3.1",
    "cytoscape-fcose": "^1.1.0",
    "cytoscape-klay": "*",
    "cytoscape-popper": "*",
    "cytoscape-spread": "^3.0.0",
    "d3": "4.10.0",
    "jquery": "^3.3.1",
    "tippy.js": "^4.3.5",
    "underscore": "^1.9.1"
  }
}
